diff --git a/src/harness.inc b/src/harness.inc
new file mode 100644
index 0000000..4289624
--- /dev/null
+++ b/src/harness.inc
@@ -0,0 +1,89 @@
+/* Evaluation harness (local to ~/syndec, not upstream): scripted input, screenshots and per-turn level-block
+ * dumps. Included at the end of game.c when SFX_HARNESS is defined.
+ *   SFX_SCRIPT=file   lines (F = game_update call number, from 0):
+ *       key F SDLNAME 0|1 | mouse F X Y | button F left|right 0|1 | shot F PATH.bmp | end F
+ *   SFX_TURNLOG=file  harness_turn() (called at the game loop head, 0x10214) appends a 16-byte header
+ *                     ("TURN", turn, frame, size) and the level block (level__Seed .. 0x9C632)
+ *   SFX_TURNS=N       exit after N turns
+ *   SFX_FAST=1        no frame limiter */
+#include <string.h>
+#include "bfscrsurf.h"
+struct HEv { long f; int kind, a, b; char path[256]; };
+static struct HEv h_ev[4096]; static int h_nev = -1; static long h_frame, h_turn, h_maxturns = -1, h_end = -1;
+static FILE *h_turnlog;
+static void harness_load(void)
+{
+    const char *p = getenv("SFX_SCRIPT"); char line[512];
+    h_nev = 0;
+    if (getenv("SFX_TURNS")) h_maxturns = atol(getenv("SFX_TURNS"));
+    if (getenv("SFX_TURNLOG")) h_turnlog = fopen(getenv("SFX_TURNLOG"), "wb");
+    if (!p) return;
+    FILE *f = fopen(p, "r"); if (!f) { fprintf(stderr, "harness: cannot read %s\n", p); exit(2); }
+    while (fgets(line, sizeof line, f) && h_nev < 4096) {
+        char c[32], s1[256], s2[256]; long fr; int n; struct HEv *e = &h_ev[h_nev];
+        s1[0] = s2[0] = 0;
+        n = sscanf(line, "%31s %ld %255s %255s", c, &fr, s1, s2);
+        if (n < 2 || c[0] == '#') continue;
+        e->f = fr; e->path[0] = 0;
+        if (!strcmp(c, "key")) { e->kind = 0; e->a = SDL_GetScancodeFromName(s1); e->b = atoi(s2);
+            if (e->a == SDL_SCANCODE_UNKNOWN) { fprintf(stderr, "harness: unknown key %s\n", s1); exit(2); } }
+        else if (!strcmp(c, "mouse")) { e->kind = 1; e->a = atoi(s1); e->b = atoi(s2); }
+        else if (!strcmp(c, "button")) { e->kind = 2; e->a = !strcmp(s1, "left") ? SDL_BUTTON_LEFT : SDL_BUTTON_RIGHT; e->b = atoi(s2); }
+        else if (!strcmp(c, "shot")) { e->kind = 3; snprintf(e->path, sizeof e->path, "%s", s1); }
+        else if (!strcmp(c, "end")) { h_end = fr; continue; }
+        else continue;
+        h_nev++;
+    }
+    fclose(f);
+}
+static int h_mx, h_my;
+static void harness_frame(void)
+{
+    int i;
+    if (h_nev < 0) harness_load();
+    for (i = 0; i < h_nev; i++) {
+        struct HEv *e = &h_ev[i]; SDL_Event ev;
+        if (e->f != h_frame) continue;
+        memset(&ev, 0, sizeof ev);
+        switch (e->kind) {
+        case 0:
+            ev.type = e->b ? SDL_KEYDOWN : SDL_KEYUP; ev.key.state = e->b ? SDL_PRESSED : SDL_RELEASED;
+            ev.key.keysym.scancode = e->a; ev.key.keysym.sym = SDL_GetKeyFromScancode(e->a);
+            SDL_PushEvent(&ev); break;
+        case 1:
+            ev.type = SDL_MOUSEMOTION; ev.motion.x = e->a; ev.motion.y = e->b;
+            ev.motion.xrel = e->a - h_mx; ev.motion.yrel = e->b - h_my; h_mx = e->a; h_my = e->b;
+            SDL_PushEvent(&ev); break;
+        case 2:
+            ev.type = e->b ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP; ev.button.button = e->a;
+            ev.button.state = e->b ? SDL_PRESSED : SDL_RELEASED; ev.button.x = h_mx; ev.button.y = h_my; ev.button.clicks = 1;
+            SDL_PushEvent(&ev); break;
+        case 3:
+            if (lbScreenSurface) SDL_SaveBMP((SDL_Surface *)lbScreenSurface, e->path);
+            break;
+        }
+    }
+    if (h_end >= 0 && h_frame >= h_end) { fprintf(stderr, "harness: end at frame %ld turn %ld\n", h_frame, h_turn); exit(0); }
+    h_frame++;
+}
+void harness_pday(uint32_t ret);
+void harness_turn(void)
+{
+    if (h_nev < 0) harness_load();
+    if (h_turn == 0) harness_pday(0);
+    if (h_turnlog) {
+        uint32_t hdr[4]; size_t len = 0x9C632 - 0x80108;
+        memcpy(hdr, "TURN", 4); hdr[1] = h_turn; hdr[2] = h_frame; hdr[3] = len;
+        fwrite(hdr, 4, 4, h_turnlog); fwrite(&level__Seed, 1, len, h_turnlog); fflush(h_turnlog);
+    }
+    h_turn++;
+    if (h_maxturns >= 0 && h_turn >= h_maxturns) { fprintf(stderr, "harness: %ld turns at frame %ld\n", h_turn, h_frame); exit(0); }
+}
+
+void harness_pday(uint32_t ret)
+{
+    static uint32_t last_ret; static long n;
+    if (h_turn > 0) return;
+    if (ret != last_ret && n) { fprintf(stderr, "pday ret=%08x count=%ld until frame %ld\n", last_ret, n, h_frame); n = 0; }
+    last_ret = ret; n++;
+}
