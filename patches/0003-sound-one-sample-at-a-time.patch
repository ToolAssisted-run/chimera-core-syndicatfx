+#if !defined(WITH_AIL2)
+/* The original's card driver (AIL 2) plays one digitized sample at a time: AIL_play_VOC_file replaces
+ * whatever plays, and BFSonundUnkn1's priority is forgotten only when the card is done (DAC_DONE). */
+static TbSampleHandle dac_sample;
+
+static void dac_play(ubyte smp_id, void *data)
+{
+    struct SampleInfo *p_smpinf;
+
+    StopAllSamples();
+    p_smpinf = PlaySampleFromAddress(0, smp_id, FULL_VOL, EQUL_PAN, NORM_PTCH, 0, 1, data);
+    dac_sample = (p_smpinf != NULL) ? p_smpinf->SampleHandle : NULL;
+}
+
+static TbBool dac_done(void)
+{
+    return dac_sample == NULL || AIL_sample_status(dac_sample) == SNDSMP_DONE;
+}
+#endif
+
 void BFPlaySample(ubyte smp_id)
 {
     struct BFSample *p_smp;
